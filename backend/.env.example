# MMmaker 环境配置示例
# 复制此文件为 .env.dev 并填写实际配置

ENV=DEV
DEBUG=true
LOG_LEVEL=DEBUG

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# 服务器
SERVER_HOST=http://localhost:8000
CORS_ALLOW_ORIGINS=*

# ===== 协调者 Agent =====
COORDINATOR_API_TYPE=openai-chat
COORDINATOR_API_KEY=
COORDINATOR_MODEL=
COORDINATOR_BASE_URL=https://api.openai.com/v1
COORDINATOR_CONTEXT_WINDOW=128000

# ===== 建模手 Agent =====
MODELER_API_TYPE=openai-chat
MODELER_API_KEY=
MODELER_MODEL=
MODELER_BASE_URL=https://api.openai.com/v1
MODELER_CONTEXT_WINDOW=128000

# ===== 代码手 Agent =====
CODER_API_TYPE=openai-chat
CODER_API_KEY=
CODER_MODEL=
CODER_BASE_URL=https://api.openai.com/v1
CODER_CONTEXT_WINDOW=128000

# ===== 写作手 Agent =====
WRITER_API_TYPE=openai-chat
WRITER_API_KEY=
WRITER_MODEL=
WRITER_BASE_URL=https://api.openai.com/v1
WRITER_CONTEXT_WINDOW=128000

# ===== 评审手 Agent =====
REVIEWER_API_TYPE=openai-chat
REVIEWER_API_KEY=
REVIEWER_MODEL=
REVIEWER_BASE_URL=https://api.openai.com/v1
REVIEWER_CONTEXT_WINDOW=128000

# ===== 执行限制 =====
MAX_CHAT_TURNS=50
MAX_RETRIES=5

# ===== 代码沙盒 =====
CODE_INTERPRETER_KIND=local
E2B_API_KEY=
JUPYTER_KERNEL_NAME=python3

# ===== 文献检索 =====
OPENALEX_EMAIL=
OPENALEX_API_KEY=

# ===== HIL 人机协作 =====
HIL_ENABLED=true
HIL_TIMEOUT=300

# ===== 质量反馈 =====
FEEDBACK_ENABLED=true
FEEDBACK_MAX_ITERATIONS=3
FEEDBACK_SCORE_THRESHOLD=7.0
